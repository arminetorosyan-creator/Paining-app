# Copy to your hosting provider's environment settings. Never commit real values.

# Required in production
NODE_ENV=production
# Behind a hosting proxy/load balancer (Render, Fly, Railway…): trust one proxy hop
TRUST_PROXY=1

# Optional
PORT=3000
DB_PATH=/app/data/app.db
UPLOAD_DIR=/app/data/uploads
CONTACT_EMAIL=support@example.com

# AI-generated guides: set to enable (https://console.anthropic.com)
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=3

# Moderation: reports needed to hide a painting until an admin reviews it
REPORT_HIDE_THRESHOLD=3
REGISTRATIONS_PER_HOUR=30
